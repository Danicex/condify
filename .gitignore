# Dependencies
node_modules/
backend/.env
# Environments & Python Virtual Envs
.env
.env.*
*myenv/
*/myenv/

# Python specific cache/compiled files (for your backend folder)
__pycache__/
*.py[cod]
*$py.class

# Local databases (dev data, never commit)
*.db

# keep the env templates, ignore real env files
!.env.example

# build output / e2e artifacts
dist/
backend/e2e/compiled.json
