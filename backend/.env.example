# Copy to backend/.env and fill in. Never commit the real file. Load it however you run the app
# (e.g. `set -a; source .env; set +a; uvicorn app.main:app --reload`).

# ── auth ──
JWT_SECRET=                 # required. openssl rand -hex 32
JWT_TTL_HOURS=24
AUTH_DOMAIN=nimlock         # shown in the sign-in message
CORS_ORIGINS=http://localhost:5173
# AUTH_DEV_MODE=1           # LOCAL ONLY: accepts an X-Dev-Address header instead of a signed login. Never set in production.

# ── database ──
DATABASE_URL=sqlite:///./nimlock.db     # use postgresql+psycopg://... in production

# ── AI tasks ──
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o                     # must accept images (photo/video proof)
OPENAI_TRANSCRIBE_MODEL=whisper-1
PASS_SCORE=0.7

# ── chain (backend talks to the lock contract) ──
RPC_URL=                                # Sepolia / Polygon JSON-RPC URL
LOCK_CONTRACT_ADDRESS=                  # the deployed USDTlock
UNLOCK_SIGNER_KEY=                      # private key whose ADDRESS you passed to USDTlock as trustedSigner (0x...)
RELAYER_PRIVATE_KEY=                    # wallet that pays gas for early releases. Fund it with ETH (Sepolia) / POL (Polygon).
                                        # Use a different key from the signer in production.
# CHAIN_ID=                             # optional, read from RPC_URL when unset
# TX_TIMEOUT=90
